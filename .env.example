REALCLANKER_DEV_MODE=true
REALCLANKER_PUBLIC_URL=http://localhost:3000
MCP_PORT=8787
MCP_URL=http://127.0.0.1:8787/mcp

# World ID for Agents — sandbox Human Continuity IdP
# Register a client at http://sandbox.auth.world.org/portal
WORLD_ID_ISSUER=https://sandbox.auth.world.org
WORLD_ID_CLIENT_ID=
WORLD_ID_CLIENT_SECRET=
# PKCS8 PEM, used when the portal client authenticates with private_key_jwt
WORLD_ID_CLIENT_PRIVATE_KEY=

# ENSv2 on Sepolia. ENS_PRIVATE_KEY is the platform wallet: it pays gas and
# the mock USDC fee. Each agent gets its own EVM wallet in .data, and that
# address owns the minted name. ENS_PARENT_NAME is the namespace those
# subnames are minted under.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_PRIVATE_KEY=
ENS_PARENT_NAME=realclanker.eth

# Sui ticket settlement. SUI_PRIVATE_KEY is the treasury, not an agent wallet.
# Fund that address from the testnet faucet (sui client faucet). The MCP server
# creates an Ed25519 wallet per agent and tops it up from this treasury when a
# purchase clears. Leave the key empty to simulate ticket objects.
SUI_NETWORK=testnet
SUI_PRIVATE_KEY=
SUI_PACKAGE_ID=
